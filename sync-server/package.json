{
  "name": "ngnl-sync-relay",
  "private": true,
  "version": "1.0.0",
  "description": "End-to-end encrypted sync relay for NoGameNoLife (Cloudflare Worker + D1)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute ngnl-sync --remote --file schema.sql",
    "db:init:local": "wrangler d1 execute ngnl-sync --local --file schema.sql"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  }
}
